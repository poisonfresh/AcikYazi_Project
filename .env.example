# Copy this file to .env and fill in your keys. .env is never committed to the repo.

# Default provider: gemini or anthropic (can also be changed in the UI)
LLM_PROVIDER=gemini

# Google Gemini — get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude — get a key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
