# Bu dosyayı .env adıyla kopyalayın ve anahtarlarınızı yazın. .env asla repoya eklenmez.

# Varsayılan sağlayıcı: gemini veya anthropic (arayüzden de değiştirilebilir)
LLM_PROVIDER=gemini

# Google Gemini — anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude — anahtar: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
