# Copy this file to .env and fill in your key. .env is never committed to the repo.

# Google Gemini — get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used by prompt_engine.py (default: gemini-3.5-flash-lite)
ACIKYAZI_MODEL=gemini-3.5-flash-lite

# 1 = run without calling the API, using fake responses (UI development, saving quota)
ACIKYAZI_MOCK=0
